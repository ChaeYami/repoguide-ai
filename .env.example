# RepoGuide AI 환경 변수 예시
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채운다 (.env는 커밋하지 않는다)
#   macOS/Linux:       cp .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env
# 필수 값은 비워 두었다. 선택 값은 기본값을 주석으로 적었고, 바꿀 때만 주석을 풀면 된다.
# 프론트엔드에는 비밀값이 없다. VITE_ 접두사 변수에 키를 넣지 않는다 (브라우저 번들에 포함됨).
# 자세한 발급 절차: specs/001-repo-manual-generator/quickstart.md 1장

# ─── 필수 ────────────────────────────────────────────────

# Google AI Studio에서 발급한 Gemini API 키
GEMINI_API_KEY=

# GitHub Fine-grained PAT (Repository access: Public repositories, 추가 권한 없음)
GITHUB_TOKEN=

# Supabase Postgres 연결 문자열 (Connect 버튼에서 복사)
# IPv6 가능: Direct connection(5432) / IPv4만 가능: Session pooler(5432)
# Transaction pooler(6543)는 쓰지 않는다. 비밀번호의 특수문자는 퍼센트 인코딩한다.
DATABASE_URL=

# 접속 출처 해시용 비밀값 (32바이트 이상 임의 문자열)
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLIENT_KEY_SALT=

# ─── 테스트 (npm run test:db 실행 시 필요) ────────────────
# 운영 DB와 다른 DB를 쓴다 (두 번째 Supabase 프로젝트 또는 로컬 Postgres)
TEST_DATABASE_URL=

# ─── Gemini 모델 ─────────────────────────────────────────
# GEMINI_MODEL_DECIDE=gemini-3.5-flash-lite
# GEMINI_MODEL_WRITE=gemini-3.8-flash

# ─── 서버·워커 ───────────────────────────────────────────
# PORT=8787
# 프록시 뒤에 배포할 때만 true
# TRUST_PROXY=false
# Gemini 요청 한도가 낮으면 1로 낮춘다
# WORKER_CONCURRENCY=2
# RETENTION_DAYS=30

# ─── 분석 한도 (Constitution VI, research.md R5) ─────────
# LIMIT_MAX_ROUNDS=3
# LIMIT_MAX_FILES=40
# LIMIT_MAX_FILES_PER_ROUND=15
# LIMIT_MAX_FILE_BYTES=200000
# LIMIT_MAX_CHARS_PER_FILE=60000
# LIMIT_MAX_CONTENT_CHARS=300000
# LIMIT_MAX_GITHUB_CALLS=80
# LIMIT_MAX_INPUT_TOKENS=400000
# LIMIT_MAX_OUTPUT_TOKENS=60000
# LIMIT_RUN_TIMEOUT_SEC=600
# LLM_MAX_OUTPUT_DECIDE=4000
# LLM_MAX_OUTPUT_WRITE=16000

# ─── 비용·요청 제한 (FR-034, FR-035) ─────────────────────
# LIMIT_MAX_COST_USD_PER_RUN=0.30
# LIMIT_DAILY_COST_USD=5
# LIMIT_REQUESTS_PER_CLIENT_PER_DAY=10
