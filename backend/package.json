{
  "name": "@repoguide/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "npm run build -w @repoguide/shared && drizzle-kit generate",
    "db:migrate": "tsx --conditions=source scripts/db-migrate.ts",
    "dev:ingest": "tsx --conditions=source scripts/dev-ingest.ts",
    "llm:ping": "tsx --conditions=source scripts/llm-ping.ts",
    "dev:analyze": "tsx --conditions=source scripts/dev-analyze.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@google/genai": "^2.30.0",
    "@repoguide/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
